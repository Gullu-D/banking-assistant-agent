# Copy this file to .env and fill in the values you want to use.
# The application works WITHOUT any keys set — it will run in deterministic
# fallback mode (rule-based query parsing, template-based summaries).

# --- Option A: OpenAI-compatible API -----------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Only set this if you are using an OpenAI-COMPATIBLE endpoint (e.g. Azure
# OpenAI, a local proxy, etc). Leave blank to use the default OpenAI API.
OPENAI_BASE_URL=

# --- Option B: Google Gemini ---------------------------------------------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Option C: Ollama (local LLM — no API key needed) --------------------
# Install from https://ollama.com, then: ollama serve && ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Set LLM_PROVIDER to force a specific provider (auto|ollama|openai|gemini).
# "auto" tries Ollama → OpenAI → Gemini in order.
LLM_PROVIDER=auto

# --- Database ---------------------------------------------------------------
# PostgreSQL: postgresql://user:password@localhost:5432/banking_agent
# Leave blank to use SQLite (auto-created at data/banking.db)
DATABASE_URL=
SECRET_KEY=change-me-in-production

# --- Auth / rate-limiting ---------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
SESSION_LIFETIME_SECONDS=86400

# --- Demo access (for presentations / viva) ---------------------------------
# Comma-separated usernames that get Pro features without a subscription.
DEMO_USERNAMES=
# Set a secret key to enable the in-app "Activate Demo Access" button.
# Users who enter this key get a 7-day demo Pro subscription.
DEMO_ACTIVATION_KEY=
DEMO_ACTIVATION_DAYS=7

# --- General ---------------------------------------------------------------
LOG_LEVEL=INFO
LLM_REQUEST_TIMEOUT_SECONDS=20

# --- Data --------------------------------------------------------------
DATA_DIR=data
TRANSACTIONS_CSV_PATH=data/transactions.csv

# --- Anomaly detection tuning (optional) --------------------------------
ANOMALY_STD_MULTIPLIER=2.0
DUPLICATE_AMOUNT_TOLERANCE=0.01
DUPLICATE_DATE_WINDOW_DAYS=3
RAPID_WINDOW_DAYS=2
RAPID_MIN_COUNT=3
RAPID_LARGE_PERCENTILE=0.75
